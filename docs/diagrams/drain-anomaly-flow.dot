// Drain template mining + anomaly flow - source for docs/SIMPLIFIED_EXPLANATION_AND_BENCHMARKS.md section 5.
// Regenerate: dot -Tpng -Gdpi=144 docs/diagrams/drain-anomaly-flow.dot -o docs/diagrams/drain-anomaly-flow.png
// Label rule: ASCII-only, max 4 plain-English words, no sentences, no \n.
digraph drain_anomaly_flow {
  graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.45", fontname="Helvetica"];
  node [shape="box", style="filled,rounded", fillcolor="#f6f8fa", color="#57606a", fontname="Helvetica", fontsize="13", margin="0.18,0.10"];
  edge [color="#57606a", fontname="Helvetica", fontsize="11", arrowsize="0.7"];

  incoming [label="incoming log line", fillcolor="#ddf4ff", color="#0969da"];
  t1 [label="tokenize by whitespace"];
  t2 [label="mask dynamic values"];
  t3 [label="traverse prefix tree"];
  match [label="cluster match?", shape=diamond, style=filled, fillcolor="#fff8c5", color="#9a6700", fontsize="11", margin="0.05,0.02"];
  known [label="update cluster count", fillcolor="#dafbe1", color="#1a7f37"];
  surge [label="sudden surge?", shape=diamond, style=filled, fillcolor="#fff8c5", color="#9a6700", fontsize="11", margin="0.05,0.02"];
  alert [label="anomaly alert!", fillcolor="#ffebe9", color="#cf222e"];
  newc  [label="new cluster template"];

  incoming -> t1 -> t2 -> t3 -> match;
  match -> known [label="yes"];
  known -> surge;
  surge -> alert [label="yes"];
  match -> newc [label="no"];
}
