// ULPF four-plane architecture - source for docs/ARCHITECTURE.md.
// Regenerate: dot -Tpng -Gdpi=144 docs/diagrams/ulpf-architecture-planes.dot -o docs/diagrams/ulpf-architecture-planes.png
// Label rule: ASCII-only, max 4 plain-English words, no sentences, no \n.
digraph planes {
  graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.5", ranksep="0.55", fontname="Helvetica"];
  node [shape="box", style="filled,rounded", fillcolor="#f6f8fa", color="#57606a", fontname="Helvetica", fontsize="13", margin="0.20,0.11"];
  edge [color="#57606a", fontname="Helvetica", fontsize="11", arrowsize="0.7"];

  src [label="perimeter devices", fillcolor="#ddf4ff", color="#0969da"];

  p1 [label="1: async ingestion (ulpf-core)", fillcolor="#ddf4ff", color="#0969da"];

  p2 [label="2: zero-copy parsing (ulpf-core)"];

  p3 [label="3: integrity storage (ulpf-integrity)", fillcolor="#dafbe1", color="#1a7f37"];

  p4 [label="4: air-gapped AI (ulpf-ai)", fillcolor="#fff8c5", color="#9a6700"];

  src -> p1 -> p2;
  p2 -> p3 [label="normalized events"];
  p2 -> p4 [label="unmapped / drift"];
}
