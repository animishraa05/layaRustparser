// Theoretical proposal vs production reality - source for docs/SIMPLIFIED_EXPLANATION_AND_BENCHMARKS.md section 2.
// Regenerate: dot -Tpng -Gdpi=144 docs/diagrams/proposal-vs-reality.dot -o docs/diagrams/proposal-vs-reality.png
// Label rule: ASCII-only, max 4 plain-English words, no sentences, no \n.
digraph proposal_vs_reality {
  graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.55", fontname="Helvetica"];
  node [shape="box", style="filled,rounded", fillcolor="#f6f8fa", color="#57606a", fontname="Helvetica", fontsize="13", margin="0.18,0.10"];
  edge [color="#57606a", fontname="Helvetica", fontsize="11", arrowsize="0.7"];

  subgraph cluster_theory {
    label="original proposal";
    labelloc="t"; style="rounded,filled"; fillcolor="#fff1f0"; color="#cf222e"; fontsize="13";
    a1 [label="eBPF XDP ingestion", fillcolor="#fff1f0", color="#cf222e"];
    b1 [label="Redpanda message broker", fillcolor="#fff1f0", color="#cf222e"];
    c1 [label="radix-tree parser", fillcolor="#fff1f0", color="#cf222e"];
    d1 [label="MiniLM embeddings", fillcolor="#fff1f0", color="#cf222e"];
    e1 [label="cloud LLM calls", fillcolor="#fff1f0", color="#cf222e"];
    a1 -> b1 -> c1 -> d1 -> e1;
  }

  subgraph cluster_reality {
    label="shipped ULPF implementation";
    labelloc="t"; style="rounded,filled"; fillcolor="#dafbe1"; color="#1a7f37"; fontsize="13";
    a2 [label="Tokio async sockets", fillcolor="#dafbe1", color="#1a7f37"];
    b2 [label="in-memory buffering", fillcolor="#dafbe1", color="#1a7f37"];
    c2 [label="Aho-Corasick classifier", fillcolor="#dafbe1", color="#1a7f37"];
    d2 [label="Rust Drain miner", fillcolor="#dafbe1", color="#1a7f37"];
    e2 [label="air-gapped synthesizer", fillcolor="#dafbe1", color="#1a7f37"];
    a2 -> b2 -> c2 -> d2 -> e2;
  }

  a1 -> a2 [style=dotted, color="#cf222e", label="matched in ULPF", constraint=false];
}
