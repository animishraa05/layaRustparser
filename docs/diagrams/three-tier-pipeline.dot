// ULPF 3-tier decision pipeline + integrity chain - source for README.md section 3.
// Regenerate: dot -Tpng -Gdpi=144 docs/diagrams/three-tier-pipeline.dot -o docs/diagrams/three-tier-pipeline.png
// Label rule: ASCII-only, max 4 plain-English words, no sentences, no \n.
digraph three_tier {
  graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.4", ranksep="0.45", fontname="Helvetica"];
  node [shape="box", style="filled,rounded", fillcolor="#f6f8fa", color="#57606a", fontname="Helvetica", fontsize="13", margin="0.18,0.10"];
  edge [color="#57606a", fontname="Helvetica", fontsize="11", arrowsize="0.7"];

  input [label="UDP/TCP syslog input", fillcolor="#ddf4ff", color="#0969da"];

  subgraph cluster_tiers {
    label="3-tier pipeline";
    labelloc="t"; style="rounded,filled"; fillcolor="#f6f8fa"; color="#57606a"; fontsize="13";
    t1 [label="Tier 1: signature LRU", fillcolor="#ddf4ff", color="#0969da"];
    t2 [label="Tier 2: Drain miner"];
    t3 [label="Tier 3: Laya triage"];
    t1 -> t2 -> t3;
  }

  extract [label="zero-copy vendor extractors"];
  ocsf    [label="OCSF 1.3 event", fillcolor="#dafbe1", color="#1a7f37"];
  batch   [label="dual-trigger batcher"];
  leaf    [label="SHA-256 + Merkle leaf", fillcolor="#fff8c5", color="#9a6700"];
  ledger  [label="ledger.jsonl (append-only)", fillcolor="#fff8c5", color="#9a6700"];
  worm    [label="Parquet WORM block", fillcolor="#dafbe1", color="#1a7f37"];
  verify  [label="ulpf verify exit code", fillcolor="#dafbe1", color="#1a7f37"];

  input -> t1;
  t3 -> extract;
  extract -> ocsf -> batch -> leaf;
  leaf -> ledger;
  leaf -> worm -> verify;
}
