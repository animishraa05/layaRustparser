// ULPF 3-tier decision pipeline + integrity chain - source for README.md section 3.
// Regenerate: dot -Tpng -Gdpi=144 docs/diagrams/three-tier-pipeline.dot -o docs/diagrams/three-tier-pipeline.png
// Rule: ASCII-only label text (no unicode symbols - some renderers show tofu).
digraph three_tier {
  graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.4", ranksep="0.45", fontname="Helvetica"];
  node [shape="box", style="filled,rounded", fillcolor="#f6f8fa", color="#57606a", fontname="Helvetica", fontsize="13", margin="0.18,0.10"];
  edge [color="#57606a", fontname="Helvetica", fontsize="11", arrowsize="0.7"];

  input [label="UDP/TCP syslog (SO_REUSEPORT, tokio workers)", fillcolor="#ddf4ff", color="#0969da"];

  subgraph cluster_tiers {
    label="3-tier pipeline (invariant 5: never blocks the hot path)";
    labelloc="t"; style="rounded,filled"; fillcolor="#f6f8fa"; color="#57606a"; fontsize="13";
    t1 [label="Tier-1: Signature LRU Cache\n16 shards x 512 entries (8,192), FxHash\n-> hit: sub-microsecond path", fillcolor="#ddf4ff", color="#0969da"];
    t2 [label="Tier-2: Drain template miner\nprefix tree + anchor tokens (ALLOW/DENY, message codes,\nclass keys - never wildcarded)\n-> miss: line-rate clustering, on miss only"];
    t3 [label="Tier-3: Laya decision engine\nbounded crossbeam ring (10,000)\n-> novel clusters triaged out-of-band, zero hallucination"];
    t1 -> t2 -> t3;
  }

  extract [label="zero-copy vendor extractors\n(cisco_asa, fortigate, paloalto, pfsense, suricata, cef - byte slices)"];
  ocsf    [label="OCSF 1.3 event (NetworkActivity 4001)", fillcolor="#dafbe1", color="#1a7f37"];
  batch   [label="batcher (dual trigger: 1,000 events / 2,000 ms)"];
  leaf    [label="SHA-256(raw) + UUIDv7 + RFC 6962 Merkle leaf", fillcolor="#fff8c5", color="#9a6700"];
  ledger  [label="ledger.jsonl (append-only)", fillcolor="#fff8c5", color="#9a6700"];
  worm    [label="Parquet WORM block\n(raw_log kept byte-for-byte)", fillcolor="#dafbe1", color="#1a7f37"];
  verify  [label="ulpf verify -> 0 / 1 / 2", fillcolor="#dafbe1", color="#1a7f37"];

  input -> t1;
  t3 -> extract;
  extract -> ocsf -> batch -> leaf;
  leaf -> ledger;
  leaf -> worm -> verify;
}
