// RFC 6962 Merkle tree with a tampered leaf - source for docs/SIMPLIFIED_EXPLANATION_AND_BENCHMARKS.md section 4.
// Regenerate: dot -Tpng -Gdpi=144 docs/diagrams/merkle-tree.dot -o docs/diagrams/merkle-tree.png
// Label rule: ASCII-only, max 4 plain-English words, no sentences, no \n.
digraph merkle_tree {
  graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.4", ranksep="0.5", fontname="Helvetica"];
  node [shape="box", style="filled,rounded", fillcolor="#f6f8fa", color="#57606a", fontname="Helvetica", fontsize="13", margin="0.18,0.10"];
  edge [color="#57606a", fontname="Helvetica", fontsize="11", arrowsize="0.7"];

  root [label="Merkle root", fillcolor="#fff8c5", color="#9a6700"];
  h12  [label="node1-2 hash"];
  h34  [label="node3-4 hash"];
  l1   [label="Cisco log tampered", fillcolor="#ffebe9", color="#cf222e", penwidth=2];
  l2   [label="Fortinet log"];
  l3   [label="Palo Alto log"];
  l4   [label="Suricata log"];

  root -> h12;
  root -> h34;
  h12 -> l1;
  h12 -> l2;
  h34 -> l3;
  h34 -> l4;
}
